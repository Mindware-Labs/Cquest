// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

/// Un artículo vive en un solo idioma; no es una traducción de otro. El blog
/// público filtra por este campo, así que /es/blog y /en/blog listan conjuntos
/// distintos en vez de repetir el mismo contenido bajo dos URLs.
/// Nombrado PostLocale y no Locale para no chocar con el tipo Locale de i18n.
enum PostLocale {
  es
  en
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id             Int        @id @default(autoincrement())
  slug           String     @unique
  title          String
  excerpt        String
  content        Json
  coverImageUrl  String
  coverImageAlt  String
  status         PostStatus @default(DRAFT)
  locale         PostLocale @default(es)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  categoryId     Int
  category       Category   @relation(fields: [categoryId], references: [id])
  authorId       Int
  author         AdminUser  @relation(fields: [authorId], references: [id])

  /// La consulta exacta del listado público: idioma + publicado + fecha ya
  /// alcanzada, ordenado por publishedAt.
  @@index([locale, status, publishedAt])
}

model Template {
  id        Int       @id @default(autoincrement())
  name      String
  blocks    Json
  createdAt DateTime  @default(now())
  authorId  Int
  author    AdminUser @relation(fields: [authorId], references: [id])
}

model AdminUser {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  createdAt    DateTime   @default(now())
  posts        Post[]
  templates    Template[]
}
