# Base de datos (Postgres). Requerida por Drizzle y Better Auth.
DATABASE_URL=

# Secreto de firma de sesiones. Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# URL pública del sitio, sin barra final. Sin ella Better Auth la infiere de la
# petición, pero los enlaces de los correos apuntarían a localhost.
NEXT_PUBLIC_SITE_URL=

# Resend. Ojo con el nombre: es API_KEY_RESEND, no RESEND_API_KEY.
API_KEY_RESEND=
RESEND_FROM=
RESEND_TO=

# Vercel Blob (portadas e imágenes del blog).
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Traducción automática de artículos.
ANTHROPIC_API_KEY=

# Analítica y mapa.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MAPBOX_TOKEN=

# reCAPTCHA v3 del formulario de cotización (opcional: sin ellas se desactiva).
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
